+      real function sbmlcl(pt,pq,pp,ptop)
+!     Lab: the pressure at which air of temperature pt and vapour pq at pp, lifted dry adiabatically with its vapour
+!     kept, reaches saturation: pp where it is saturated there, ptop where it is still unsaturated at ptop, and
+!     between the two by 24 halvings of the interval in log pressure
+      real, intent(in) :: pt,pq,pp,ptop
+      real :: zlo,zhi,zmid,zpm
+      integer :: jit
+      if(pq >= sbmqs(pt,pp)) then
+       sbmlcl=pp
+       return
+      endif
+      if(pq < sbmqs(pt*(ptop/pp)**akap,ptop)) then
+       sbmlcl=ptop
+       return
+      endif
+      zlo=log(ptop)
+      zhi=log(pp)
+      do jit=1,24
+       zmid=0.5*(zlo+zhi)
+       zpm=exp(zmid)
+       if(pq >= sbmqs(pt*(zpm/pp)**akap,zpm)) then
+        zlo=zmid
+       else
+        zhi=zmid
+       endif
+      enddo
+      sbmlcl=exp(0.5*(zlo+zhi))
+      end function sbmlcl
