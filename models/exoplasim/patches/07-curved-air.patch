+      subroutine twilight_lw
+      use radmod
+      implicit none
+!
+!     Terluna: the infrared the Moon's curved air loses beyond a flat column (climate/gcm/twilight.py): each
+!     layer's and the ground's extra escape to space at the design column's temperatures, scaled with their
+!     own to the fourth power, carried up to the top as upward flux (negative in PlaSim)
+!
+      integer :: jhor, jlev
+      real :: zsum
+      do jhor = 1, NHOR
+       zsum = twlw(NLEP) * (dt(jhor,NLEP) / twlt(NLEP))**4
+       dftu(jhor,NLEP) = dftu(jhor,NLEP) - zsum
+       dlwfl(jhor,NLEP) = dlwfl(jhor,NLEP) - zsum
+       do jlev = NLEV, 1, -1
+        zsum = zsum + twlw(jlev) * (dt(jhor,jlev) / twlt(jlev))**4
+        dftu(jhor,jlev) = dftu(jhor,jlev) - zsum
+        dlwfl(jhor,jlev) = dlwfl(jhor,jlev) - zsum
+       enddo
+      enddo
+      return
+      end subroutine twilight_lw
