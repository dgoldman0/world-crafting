+      subroutine twilight_term
+      use radmod
+      implicit none
+!
+!     Terluna: the sunlight the Moon's curved air adds to the flat column (climate/gcm/twilight.py), by the
+!     solar elevation at each point, below the horizon too: to each layer and, in the column's clear share,
+!     to the ground, carried down from the top as net downward flux
+!
+      integer :: jhor, jlev, jlo, jhi, jmid
+      real :: zel, zu, zsum, zclear, zsun
+      zsun = gsol0 * gdist2
+      do jhor = 1, NHOR
+       zel = asin(max(-1.0, min(1.0, gmuz(jhor)))) * 180.0 / PI
+       if (zel < twlel(1) .or. zel > twlel(ntwl)) cycle
+       jlo = 1
+       jhi = ntwl
+       do while (jhi - jlo > 1)
+        jmid = (jlo + jhi) / 2
+        if (twlel(jmid) > zel) then
+         jhi = jmid
+        else
+         jlo = jmid
+        endif
+       enddo
+       zu = (zel - twlel(jlo)) / (twlel(jhi) - twlel(jlo))
+       zclear = 1.0
+       do jlev = 1, NLEV
+        zclear = zclear * (1.0 - dcc(jhor,jlev) * nclouds)
+       enddo
+       zsum = zsun * ((1.0 - zu) * twlg(jlo) + zu * twlg(jhi)) * zclear
+       dswfl(jhor,NLEP) = dswfl(jhor,NLEP) + zsum
+       dfd(jhor,NLEP) = dfd(jhor,NLEP) + zsum
+       do jlev = NLEV, 1, -1
+        zsum = zsum + zsun * ((1.0 - zu) * twlq(jlev,jlo) + zu * twlq(jlev,jhi))
+        dswfl(jhor,jlev) = dswfl(jhor,jlev) + zsum
+        dfd(jhor,jlev) = dfd(jhor,jlev) + zsum
+       enddo
+      enddo
+      return
+      end subroutine twilight_term
+
