+!     ================
+!     SUBROUTINE MKSBM
+!     ================
+
+      subroutine mksbm
+      use rainmod
+!
+!     Lab: the simplified Betts-Miller scheme of Frierson (2007, J. Atmos. Sci. 64, 1959-1976), which nprc = 2
+!     calls in place of Kuo's. A parcel lifted from the lowest level, dry and then moist adiabatically with
+!     PlaSim's saturation, and mixing in the share 1 - exp(-eps_bm*ln(p_below/p)) of the surrounding air in each
+!     layer it crosses, gives the reference temperature from the lowest level to the top of its buoyancy; rh_bm of
+!     saturation at that temperature gives the reference vapour. Where the parcel is buoyant above its start, the
+!     temperature and vapour relax toward the references over tau_bm seconds, at least deltsec2. The rain is the
+!     vapour the column loses, formed at each level in proportion to the vapour removed there, and one heating
+!     added through the convecting layers releases its latent heat, so that the column keeps its moist enthalpy.
+!     A column whose relaxation would remove no vapour, whose parcel's inhibition exceeds cin_bm J/kg where that
+!     limit is set, or whose top's pressure exceeds pdeep takes PlaSim's shallow scheme, as under Kuo's. The
+!     statements are Terluna's (climate/gcm/exoplasim_run.py, SBM_CODE, on domain/climate at 39c5ee04)
+!
+      integer :: ishallow(NHOR), ilift(NHOR), itop(NHOR)
+      integer :: jhor, jlev, jtop, jlfc
+      real :: zte(NHOR,NLEV), zqe(NHOR,NLEV), zdtdts(NHOR,NLEV), zdqdts(NHOR,NLEV), zdtc(NHOR,NLEV)
+      real :: ztp(NLEV), zdtr(NLEV), zdqr(NLEV), zm(NLEV), zcp(NLEV), zp(NLEV)
+      real :: ztnew, zqnew, zmix, zcin, zpq, zpt, zcpm, zcorr, zcond, ztau
+!
+      ztau=max(tau_bm,deltsec2)
+      ishallow(:)=0
+      ilift(:)=-1
+      itop(:)=-1
+      icctot(:)=0
+      icclev(:,:)=0
+      dprcl(:,:)=0.
+      dprscl(:,:)=0.
+      zdtdts(:,:)=0.
+      zdqdts(:,:)=0.
+      zdtc(:,:)=0.
+      if(ndiaggp==1) then
+       do jlev=1,NLEV
+        dgp3d(:,jlev,16)=-dqdt(:,jlev)*dp(:)*dsigma(jlev)/ga/1000.
+        dgp3d(:,jlev,18)=dqt(:,jlev)*dp(:)*dsigma(jlev)/ga/1000.
+       enddo
+      end if
+      zte(:,:)=dt(:,1:NLEV)+dtdt(:,1:NLEV)*deltsec2
+      zqe(:,:)=dq(:,1:NLEV)+dqdt(:,1:NLEV)*deltsec2
+!
+      do jhor=1,NHOR
+       zp(:)=dp(jhor)*sigma(:)
+       zm(:)=dp(jhor)*dsigma(:)/ga
+       zcp(:)=acpd*(1.+ADV*zqe(jhor,:))
+!      the parcel, from the lowest level up
+       ztnew=zte(jhor,NLEV)
+       zqnew=zqe(jhor,NLEV)
+       call sbmsat(ztnew,zqnew,zp(NLEV))
+       ztp(NLEV)=ztnew
+       do jlev=NLEM,1,-1
+        ztnew=ztnew*(sigma(jlev)/sigma(jlev+1))**akap
+        if(eps_bm > 0.) then
+         zmix=1.-exp(-eps_bm*log(sigma(jlev+1)/sigma(jlev)))
+         ztnew=(1.-zmix)*ztnew+zmix*zte(jhor,jlev)
+         zqnew=(1.-zmix)*zqnew+zmix*zqe(jhor,jlev)
+        endif
+        call sbmsat(ztnew,zqnew,zp(jlev))
+        ztp(jlev)=ztnew
+       enddo
+!      its level of free convection, the lowest above its start where it is buoyant, and its top, the last level
+!      above that through which it stays buoyant
+       jlfc=0
+       do jlev=NLEM,1,-1
+        if(ztp(jlev) > zte(jhor,jlev)) then
+         jlfc=jlev
+         exit
+        endif
+       enddo
+       if(jlfc == 0) cycle
+       jtop=jlfc
+       do jlev=jlfc-1,1,-1
+        if(ztp(jlev) <= zte(jhor,jlev)) exit
+        jtop=jlev
+       enddo
+!      its inhibition (J/kg), from its start to its level of free convection
+       zcin=0.
+       do jlev=jlfc+1,NLEV
+        zcin=zcin+gascon*max(0.,zte(jhor,jlev)-ztp(jlev))*dsigma(jlev)/sigma(jlev)
+       enddo
+!      the relaxation toward the references, from the lowest level to the top
+       zpq=0.
+       zpt=0.
+       zcpm=0.
+       do jlev=jtop,NLEV
+        zdtr(jlev)=(ztp(jlev)-zte(jhor,jlev))/ztau
+        zdqr(jlev)=(rh_bm*sbmqs(ztp(jlev),zp(jlev))-zqe(jhor,jlev))/ztau
+        zpq=zpq-zdqr(jlev)*zm(jlev)
+        zpt=zpt+zcp(jlev)*zdtr(jlev)*zm(jlev)
+        zcpm=zcpm+zcp(jlev)*zm(jlev)
+       enddo
+       if(zpq <= 0. .or. zp(jtop) > pdeep .or. (cin_bm > 0. .and. zcin > cin_bm)) then
+        if(nshallow == 1) then
+         ishallow(jhor)=1
+         ilift(jhor)=NLEP
+         itop(jhor)=jtop
+        endif
+        cycle
+       endif
+!      deep convection: one heating added through the layers releases the rain's latent heat, and the rain forms
+!      where the vapour is removed
+       zcorr=(ALV*zpq-zpt)/zcpm
+       zcond=0.
+       do jlev=jtop,NLEV
+        zdtr(jlev)=zdtr(jlev)+zcorr
+        zcond=zcond+max(0.,-zdqr(jlev))*zm(jlev)
+       enddo
+       do jlev=jtop,NLEV
+        dtdt(jhor,jlev)=dtdt(jhor,jlev)+zdtr(jlev)
+        dqdt(jhor,jlev)=dqdt(jhor,jlev)+zdqr(jlev)
+        zdtc(jhor,jlev)=zdtr(jlev)
+        if(zdqr(jlev) < 0.) then
+         dprcl(jhor,jlev)=-zdqr(jlev)*zpq/zcond*dsigma(jlev)
+         icclev(jhor,jlev)=1
+         icctot(jhor)=icctot(jhor)+1
+         if(sigma(jlev) < 0.4 .and. jlev == jtop) icclev(jhor,jlev)=2
+        endif
+       enddo
+      enddo
+!
+      if(nshallow == 1) then
+       call mkshallow(zte,zqe,ishallow,ilift,itop,zdtdts,zdqdts)
+       dtdt(:,1:NLEV)=dtdt(:,1:NLEV)+zdtdts(:,1:NLEV)
+       dqdt(:,1:NLEV)=dqdt(:,1:NLEV)+zdqdts(:,1:NLEV)
+      endif
+!     Kuo's diagnostics 8 and 16: the heating (K/s) and the vapour (m/s of water) by layer that the deep and the
+!     shallow convection add, slot 16 set above to minus the vapour's tendency before the scheme
+      if(ndiaggp==1) then
+       do jlev=1,NLEV
+        dgp3d(:,jlev,8)=zdtc(:,jlev)+zdtdts(:,jlev)
+        dgp3d(:,jlev,16)=dgp3d(:,jlev,16)+dqdt(:,jlev)*dp(:)*dsigma(jlev)/ga/1000.
+       enddo
+      end if
+      return
+!
+      contains
+!
+      real function sbmqs(pt,pp)
+!     saturation specific humidity, as Kuo's parcel takes it
+      real, intent(in) :: pt,pp
+      real :: zqs
+      zqs=rdbrv*ra1*exp(ra2*(pt-TMELT)/(pt-ra4))/pp
+      zqs=min(zqs,rdbrv)
+      sbmqs=zqs/(1.-(1./rdbrv-1.)*zqs)
+      end function sbmqs
+!
+      subroutine sbmsat(pt,pq,pp)
+!     a supersaturated parcel condensed to saturation in two steps, as Kuo's parcel is, with the latent heat of
+!     sublimation below freezing
+      real, intent(inout) :: pt,pq
+      real, intent(in) :: pp
+      real :: zqs,zcor,zlcp,zdqsdt,zrain
+      integer :: jit
+      do jit=1,2
+       zqs=rdbrv*ra1*exp(ra2*(pt-TMELT)/(pt-ra4))/pp
+       zqs=min(zqs,rdbrv)
+       zcor=1./(1.-(1./rdbrv-1.)*zqs)
+       zqs=zqs*zcor
+       if(zqs >= pq) return
+       if(pt < TMELT) then
+        zlcp=ALS/(acpd*(1.+ADV*pq))
+       else
+        zlcp=ALV/(acpd*(1.+ADV*pq))
+       endif
+       zdqsdt=ra2*(TMELT-ra4)*zqs*zcor/((pt-ra4)*(pt-ra4))
+       zrain=(pq-zqs)/(1.+zlcp*zdqsdt)
+       pt=pt+zlcp*zrain
+       pq=pq-zrain
+      enddo
+      end subroutine sbmsat
+!
+      end subroutine mksbm
+
