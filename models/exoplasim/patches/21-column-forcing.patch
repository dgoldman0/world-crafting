+!     ====================
+!     SUBROUTINE COLWINDOW
+!     ====================
+
+!     Lab: the forcing of a column (ncolforce = 1). A window runs from one output step to the step before the
+!     next, and from a run's first step to the step before its first output. At the step that ends a window
+!     the dynamics' tendencies over it are the storage of the state the physics sees, from the window's first
+!     step to this step, less the mean of the physics' tendencies over the window's steps, at each grid point;
+!     outgp writes them with this step's state, which starts the next window. A window of no steps, the first
+!     with output at every step, gives tendencies of 0
+
+      subroutine colwindow
+      use pumamod
+      real :: zr                    ! 1 / the window's length (1/s)
+      logical :: lout               ! an output falls at this step
+
+      lout = mod(nhcstp,nafter) == 0
+      if (ncfacc >= 0 .and. .not. lout) return
+      if (ncfacc > 0) then
+       zr = 1.0 / (real(ncfacc) * deltsec)
+       cfdt(:,:) = (dt(:,1:NLEV) - cft0(:,:)) * zr - cfst(:,:) / real(ncfacc)
+       cfdq(:,:) = (dq(:,1:NLEV) - cfq0(:,:)) * zr - cfsq(:,:) / real(ncfacc)
+       cfdu(:,:) = (du(:,1:NLEV) - cfu0(:,:)) * zr - cfsu(:,:) / real(ncfacc)
+       cfdv(:,:) = (dv(:,1:NLEV) - cfv0(:,:)) * zr - cfsv(:,:) / real(ncfacc)
+       cfdp(:)   = (log(dp(:)) - cfp0(:)) * zr
+      elseif (lout) then
+       cfdt(:,:) = 0.0
+       cfdq(:,:) = 0.0
+       cfdu(:,:) = 0.0
+       cfdv(:,:) = 0.0
+       cfdp(:)   = 0.0
+      endif
+      cft0(:,:) = dt(:,1:NLEV)
+      cfq0(:,:) = dq(:,1:NLEV)
+      cfu0(:,:) = du(:,1:NLEV)
+      cfv0(:,:) = dv(:,1:NLEV)
+      cfp0(:)   = log(dp(:))
+      cfst(:,:) = 0.0
+      cfsq(:,:) = 0.0
+      cfsu(:,:) = 0.0
+      cfsv(:,:) = 0.0
+      ncfacc = 0
+      return
+      end subroutine colwindow
+
+!     =================
+!     SUBROUTINE COLSUM
+!     =================
+
+!     Lab: the physics' tendencies of this step added to the window's sums, as gridpointd hands them to the
+!     spectral step: temperature and winds from dtdt, dudt and dvdt, and the vapour from gqdt, which holds the
+!     humidity fixer's part beside dqdt
+
+      subroutine colsum
+      use pumamod
+      cfst(:,:) = cfst(:,:) + dtdt(:,1:NLEV)
+      cfsu(:,:) = cfsu(:,:) + dudt(:,1:NLEV)
+      cfsv(:,:) = cfsv(:,:) + dvdt(:,1:NLEV)
+      do jlev = 1 , NLEV
+       cfsq(:,jlev) = cfsq(:,jlev) + gqdt(:,jlev) * ww * psurf / dp(:)
+      enddo
+      ncfacc = ncfacc + 1
+      return
+      end subroutine colsum
+
+!     ==================
+!     SUBROUTINE COLDUMP
+!     ==================
+
+!     Lab: the physics' inputs (kpart 1) and outputs (kpart 2) at every grid point, in double precision, appended
+!     to plasim_column on unit 48 for the run's first ncoldump steps. Each part is one record of its header,
+!     the step, the part, the grid points, the levels and the record's count of values, followed by one record of
+!     the values. Part 1 holds the state the physics sees: temperature and specific humidity with the surface's
+!     in their last level, the winds and the surface pressure (Pa), then psurf. Part 2 holds the physics'
+!     tendencies of temperature, vapour and the winds (dtdt, dqdt, dudt, dvdt), the dynamics' vapour tendency
+!     that Kuo's scheme read (dqt), the vapour tendency in gqdt's units, the temperature and humidity after the
+!     physics, again with the surface's, the convective, large-scale and snow precipitation, the evaporation,
+!     the sensible and latent heat fluxes, the net solar and thermal radiation at the ground and the cloud cover
+
+      subroutine coldump(kpart)
+      use pumamod
+      integer :: kpart
+      integer :: ihead(6)
+      real, allocatable :: zf(:,:), zall(:)
+      integer :: icount, ioff
+      logical, save :: lopen = .false.
+
+      if (kpart == 1) then
+       icount = 2 * NUGP * NLEP + 2 * NUGP * NLEV + NUGP + 1
+      else
+       icount = 6 * NUGP * NLEV + 2 * NUGP * NLEP + 8 * NUGP + NUGP * NLEV
+      endif
+      allocate(zall(icount))
+      allocate(zf(NUGP,NLEP))
+      ioff = 0
+      if (kpart == 1) then
+       call colput(dt,NLEP)
+       call colput(dq,NLEP)
+       call colput(du,NLEV)
+       call colput(dv,NLEV)
+       call colput(dp,1)
+       zall(ioff+1) = psurf
+       ioff = ioff + 1
+      else
+       call colput(dtdt,NLEV)
+       call colput(dqdt,NLEV)
+       call colput(dudt,NLEV)
+       call colput(dvdt,NLEV)
+       call colput(dqt,NLEV)
+       call colput(gqdt,NLEV)
+       call colput(dt,NLEP)
+       call colput(dq,NLEP)
+       call colput(dprc,1)
+       call colput(dprl,1)
+       call colput(dprs,1)
+       call colput(devap,1)
+       call colput(dshfl,1)
+       call colput(dlhfl,1)
+       call colput(dswfl(:,NLEP),1)
+       call colput(dlwfl(:,NLEP),1)
+       call colput(dcc,NLEV)
+      endif
+      if (mypid == NROOT) then
+       if (.not. lopen) then
+        open(48,file='plasim_column',form='unformatted')
+        lopen = .true.
+       endif
+       ihead(:) = (/ nstep, kpart, NUGP, NLEV, icount, 0 /)
+       write(48) ihead
+       write(48) zall(1:ioff)
+       flush(48)
+      endif
+      deallocate(zf,zall)
+      return
+
+      contains
+
+      subroutine colput(pf,klev)
+      integer :: klev
+      real :: pf(NHOR,klev)
+      call mpgagp(zf,pf,klev)
+      if (mypid == NROOT) zall(ioff+1:ioff+NUGP*klev) = reshape(zf(:,1:klev),(/NUGP*klev/))
+      ioff = ioff + NUGP * klev
+      end subroutine colput
+
+      end subroutine coldump
+
