       enddo
 
 !
+!     Lab: the wind at 10 m (nwind10 = 1), on Geleyn's (1988) profile through the lowest layer from the drag
+!     computed above: u(z) = u_L (ln(1 + z/z0) - (z/z_L) (B_N - B_D)) / B_D, with B_N = ln(1 + z_L/z0) and
+!     B_D = vonkarman/sqrt(C_D) = ln(1 + z_L/dz0)/sqrt(zrifm), C_D the drag coefficient of dtransm against
+!     the wind of the bulk formulas and z0 the roughness of that drag (zz0w). Neutral air takes the log law,
+!     stable air brings less of the lowest level's wind down and unstable air more, and the factor on that
+!     wind is held between 0 and 1. du10 and dv10 go to the output alone, and the model's state stays as it was
+!
+      if (nwind10 == 1) then
+       do jhor=1,NHOR
+        zbd=LOG(zbz0(jhor)+1.)/SQRT(zrifm(jhor))
+        zbn=LOG(znl(jhor)/zz0w(jhor)+1.)
+        zf10=(LOG(1.+10./zz0w(jhor))-10./znl(jhor)*(zbn-zbd))/zbd
+        zf10=MAX(0.,MIN(1.,zf10))
+        du10(jhor)=zf10*du(jhor,NLEV)
+        dv10(jhor)=zf10*dv(jhor,NLEV)
+       enddo
+      endif
