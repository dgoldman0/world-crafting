+      subroutine lw_correction
+      use radmod
+      implicit none
+!
+!     Terluna: the longwave by height (climate/gcm/plasim_longwave.py): each layer's and the ground's extra
+!     escape to space, fitted over land and over sea to the correlated-k model, scaled with its own
+!     temperature to the fourth power and carried up to the top as upward flux (negative in PlaSim)
+!
+      integer :: jhor, jlev
+      real :: zsum, zland
+      do jhor = 1, NHOR
+       zland = dls(jhor)
+       zsum = (zland*lwcl(NLEP) + (1.-zland)*lwcs(NLEP)) * (dt(jhor,NLEP) / lwct(NLEP))**4
+       dftu(jhor,NLEP) = dftu(jhor,NLEP) - zsum
+       dlwfl(jhor,NLEP) = dlwfl(jhor,NLEP) - zsum
+       do jlev = NLEV, 1, -1
+        zsum = zsum + (zland*lwcl(jlev) + (1.-zland)*lwcs(jlev)) * (dt(jhor,jlev) / lwct(jlev))**4
+        dftu(jhor,jlev) = dftu(jhor,jlev) - zsum
+        dlwfl(jhor,jlev) = dlwfl(jhor,jlev) - zsum
+       enddo
+      enddo
+      return
+      end subroutine lw_correction
+
