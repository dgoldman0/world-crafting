       ENDIF
 
+      ! Lab: with ipbl2_per_mass = 1, the simple boundary layer's tendencies per unit mass. turbsz, turbuz and turbvz
+      ! return rho times the change per second, as turbtend.F's own path expects before it divides by the density;
+      ! solve1.F adds thpten, qvpten, qcpten, qipten, upten and vpten as changes per second, so the density is
+      ! divided out here, at u and v points for the wind. From Terluna's PBL_DENSITY_PATCH (domain/climate 13e7123).
+      IF( ipbl2_per_mass.eq.1 )THEN
+      !$omp parallel do default(shared)   &
+      !$omp private(i,j,k)
+      do k=1,nk
+        do j=1,nj
+        do i=1,ni
+          thpten(i,j,k) = thpten(i,j,k)*rr(i,j,k)
+          qvpten(i,j,k) = qvpten(i,j,k)*rr(i,j,k)
+          qcpten(i,j,k) = qcpten(i,j,k)*rr(i,j,k)
+          qipten(i,j,k) = qipten(i,j,k)*rr(i,j,k)
+        enddo
+        enddo
+        do j=1,nj
+        do i=1,ni+1
+          upten(i,j,k) = upten(i,j,k)/(0.5*(rho(i-1,j,k)+rho(i,j,k)))
+        enddo
+        enddo
+        do j=1,nj+1
+        do i=1,ni
+          vpten(i,j,k) = vpten(i,j,k)/(0.5*(rho(i,j-1,k)+rho(i,j,k)))
+        enddo
+        enddo
+      enddo
+      ENDIF
+
       endif  dobr09
 
