 CONTAINS
 
 !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
+      REAL FUNCTION LAB_RAIN(LAM,M)
+      ! Lab: rain's mass-weighted (M = 1) or number-weighted (M = 2) mean fall speed (m/s), or the ventilation
+      ! integral of its evaporation (M = 3, m3 s**-0.5), in Morrison's reference air, for an exponential spectrum
+      ! of slope LAM (1/m): the table read from lab_rain_law.txt, linear in ln(LAM) and constant beyond its two ends
+      IMPLICIT NONE
+      REAL, INTENT(IN) :: LAM
+      INTEGER, INTENT(IN) :: M
+      REAL :: X,W
+      INTEGER :: I
+      X = (LOG(LAM)-LAB_RX0)/LAB_RDX
+      I = MIN(MAX(INT(X),0),LAB_RN-2)
+      W = MIN(MAX(X-REAL(I),0.),1.)
+      LAB_RAIN = EXP((1.-W)*LAB_RT(M,I+1)+W*LAB_RT(M,I+2))
+      END FUNCTION LAB_RAIN
+
+!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
